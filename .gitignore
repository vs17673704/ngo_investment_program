# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
/.claude
/artifacts
*agent*
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/browser/artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*back*.log
CHANGE_PROGRESS.md
/*.log

# env files (can opt-in for committing if needed)
.env*

# real Firebase service-account credentials (server-side secret, never committed)
/firebase_prerequisites

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

certificates

# scratch / reference material (not read by the app at build or runtime)
/backups/
/audit_scratch/
/stitch_design/
/docs/
/prompts/